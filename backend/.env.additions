# --- BE-3 additions — add these lines to your existing .env ---

# BE-3 item 7: which EPP tenors this platform offers. Keep in sync with
# sql/001_epp_tenor_constraint.sql — see BE-3-NOTES.md.
EPP_ALLOWED_TENORS=3,6,12,18,24,36,48,60

# BE-3 item 4: shared secret the OTHER bank sends back on its settlement
# webhook for external bank transfers. Generate a real one, don't ship
# "change-me":
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
EXTERNAL_TRANSFER_WEBHOOK_SECRET=change-me

# BE-3 item 8: IANA timezone the daily report's "day" boundary is measured in.
REPORT_TIMEZONE=Africa/Cairo

# --- Already required by the existing bank.client.js / moi.service.js —
# confirm these are already in your .env, not new: ---
# MOI_BASE_URL=http://localhost:8000
# MOI_API_KEY=wit-intern-2026
